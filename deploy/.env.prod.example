# Production settings. Copy to deploy/.env.prod (git-ignored) and fill in:
#   cp deploy/.env.prod.example deploy/.env.prod
# make deploy copies it to the server as ~/relay/.env with chmod 600.
# Values marked (terraform) come from `terraform -chdir=deploy/terraform output`.

# The server. (terraform) public_ip.
DEPLOY_HOST=
DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=~/.ssh/relay_ed25519

# The site's name. (terraform) domain — e.g. 3-121-4-17.sslip.io, or your own domain
# with an A record pointing at the public IP.
DOMAIN=
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# Secrets: make them long and random, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Profile pictures in S3. (terraform) bucket, region, upload_origin.
# No keys: the server's IAM role grants access to this one bucket.
S3_BUCKET=
S3_REGION=eu-central-1
S3_UPLOAD_ORIGIN=

# Or: run RustFS on the server instead of S3 (no AWS needed). Then also set
# S3_ACCESS_KEY / S3_SECRET_KEY to values of your choice and S3_UPLOAD_ORIGIN empty.
LOCAL_STORAGE=false
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Start Prometheus, Loki, Alloy and Grafana too (~350 MiB of RAM).
MONITORING=true

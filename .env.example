# Copy to .env (git-ignored) and change the password: cp .env.example .env
# Docker Compose and the Makefile both read this file.
# Every backend setting and its production default: knowledge-base/phases/phase-0/0.2-backend-skeleton/design.md

POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay
POSTGRES_PORT=5432

# Dev mode: the API runs on your machine, so it reaches Postgres via localhost.
# (Full mode overrides this in compose.yaml — inside Docker the host is "postgres".)
DATABASE_URL=postgres://relay:change-me@localhost:5432/relay?sslmode=disable
PORT=8080

# Dev overrides of production defaults (production: info, json, 5s).
LOG_LEVEL=debug
LOG_FORMAT=console
SHUTDOWN_DRAIN_DELAY=0s

# Pool settings (note 11) — defaults shown; uncomment to experiment.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m

# Copy to .env (git-ignored) and change the password: cp .env.example .env
# Docker Compose and the Makefile both read this file.

POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay
POSTGRES_PORT=5432

# Dev mode: the API runs on your machine, so it reaches Postgres via localhost.
# (Full mode overrides this in compose.yaml — inside Docker the host is "postgres".)
DATABASE_URL=postgres://relay:change-me@localhost:5432/relay?sslmode=disable

API_PORT=8080

# Signs access tokens and WebSocket tickets. At least 32 bytes — make your own:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# false while we're on http://localhost; true once we serve HTTPS (Phase 2).
COOKIE_SECURE=false

# Object storage for profile pictures (Part 2.2): RustFS locally, AWS S3 in production.
# The same keys create the RustFS account (compose.yaml) and let the API use it.
S3_ACCESS_KEY=relay
S3_SECRET_KEY=change-me-too
S3_ENDPOINT=localhost:9000
S3_PUBLIC_URL=/storage
S3_CREATE_BUCKET=true

# Integration tests create (and drop) their own throwaway databases through this user.
TEST_DATABASE_URL=postgres://relay:change-me@localhost:5432/relay?sslmode=disable
# …and storage tests use a throwaway bucket here.
TEST_S3_ENDPOINT=localhost:9000
TEST_S3_ACCESS_KEY=relay
TEST_S3_SECRET_KEY=change-me-too

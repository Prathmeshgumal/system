# Full-mode reverse proxy — the production version of Vite's dev proxy.
# The browser only ever talks to Caddy, so React and the API share one origin.
# See knowledge-base/notes/phase-0-notes.md, note 1.
:80 {
	# Only /api is forwarded. /livez and /readyz are for infrastructure and
	# are deliberately NOT exposed here. (/ws is added in Part 1.3.)
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the React app. Unknown paths fall back to index.html
	# so client-side routes (Part 0.3) work on refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}

# Full-mode reverse proxy — the production version of Vite's dev proxy.
# The browser only ever talks to Caddy, so React and the API share one origin.
# See knowledge-base/Notes.md, note 1.
:80 {
	# Only /api and /ws are forwarded. /livez and /readyz are for infrastructure
	# and are deliberately NOT exposed here.
	handle /api/* {
		reverse_proxy api:8080
	}

	# WebSockets: Caddy passes the Upgrade handshake through by itself.
	handle /ws {
		reverse_proxy api:8080
	}

	# Profile pictures: served by the API (which reads them from storage)…
	handle /media/* {
		reverse_proxy api:8080
	}

	# …and uploaded by the browser straight to storage (presigned POST).
	# handle_path strips /storage, so /storage/relay-media/ → storage:9000/relay-media/.
	handle_path /storage/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy storage:9000
	}

	# Everything else is the React app. Unknown paths fall back to index.html
	# so client-side routes (Part 0.3) work on refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}
